# ─────────────────────────────────────────────────────────────
# DentalDesk · Variables de entorno (plantilla)
# Copiá este archivo como .env.local y completá los valores.
# NUNCA commitees .env.local (ya está en .gitignore).
# ─────────────────────────────────────────────────────────────

# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=                 # clave pública (anon) del proyecto
SUPABASE_SERVICE_ROLE_KEY=                     # clave privada service_role — SOLO server, NUNCA exponer al cliente

# ── App / marca de la plataforma ──
# Todo lo de este bloque define la IDENTIDAD DEL SISTEMA (no la de una clínica).
# Cambiándolo acá, el sistema se replica con otra marca sin tocar el código.
NEXT_PUBLIC_APP_NAME=DentalDesk                # nombre comercial del producto
NEXT_PUBLIC_APP_URL=https://tu-dominio.com     # URL pública del SaaS (sin barra final)
NEXT_PUBLIC_ADMIN_EMAIL=                       # email del super-admin (accede a /admin)
NEXT_PUBLIC_DEFAULT_TENANT_ID=                 # tenant por defecto (fallback del portal de paciente)

# Dominio verificado en Resend desde el que salen TODOS los emails.
# El nombre de cada clínica va como display name, pero el dominio es el de la
# plataforma (si no, cada clínica necesitaría verificar su propio dominio).
EMAIL_DOMAIN=tu-dominio.com
EMAIL_FROM_TURNOS=turnos@tu-dominio.com        # opcional, por defecto turnos@$EMAIL_DOMAIN
EMAIL_FROM_RECORDATORIOS=recordatorios@tu-dominio.com  # opcional

# ── Emails (Resend) ──
RESEND_API_KEY=                                # API key de Resend
RESEND_WEBHOOK_SECRET=                         # secreto para validar webhooks de Resend

# ── Tareas programadas / endpoints internos ──
CRON_SECRET=                                   # secreto Bearer para /api/cron y recordatorios
SYNC_SHEET_SECRET=                             # secreto Bearer para /api/sync-sheet (mismo valor en el header del Database Webhook de Supabase). Generar: openssl rand -hex 32

# ── MercadoPago (etapa final, antes de lanzar) ──
MERCADOPAGO_ACCESS_TOKEN=                      # access token para crear y consultar suscripciones
MERCADOPAGO_WEBHOOK_SECRET=                    # "clave secreta" que da MercadoPago al configurar el webhook (valida la firma x-signature)

# ── Facturación electrónica ARCA (ex AFIP) ──
# Credenciales de la PLATAFORMA (esquema de delegación: cada clínica delega el
# servicio wsfe al CUIT de la plataforma desde "Administrador de Relaciones").
# Si este bloque está vacío, las facturas se emiten en MODO SIMULACIÓN
# (CAE ficticio, marcadas como "simulada", sin validez fiscal).
ARCA_CUIT=                                     # CUIT de la plataforma (solo dígitos)
ARCA_CERT=                                     # certificado X.509 emitido por ARCA (PEM, con \n escapados)
ARCA_PRIVATE_KEY=                              # clave privada del certificado (PEM, con \n escapados)
ARCA_PRODUCTION=false                          # true = emite comprobantes REALES; false = homologación
NEXT_PUBLIC_ARCA_PLATFORM_CUIT=                # CUIT de la plataforma formateado (se muestra en la UI de configuración)

# ── Google Sheets (sincronización opcional de turnos) ──
GOOGLE_SERVICE_ACCOUNT_EMAIL=                  # email de la cuenta de servicio
GOOGLE_PRIVATE_KEY=                            # private key (con \n escapados)
GOOGLE_SHEET_ID=                               # ID de la planilla destino
